# Copy to .env.local and fill in. Server-side only: never prefix with NEXT_PUBLIC_.

# Google AI Studio key for the try-on (see README, "Getting a Gemini key").
GEMINI_API_KEY=

# Optional. The image editing model; change it if Google renames the model.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional. Send Gemini calls through a gateway instead of Google directly.
# GEMINI_BASE_URL=

# Optional. 1 = lay the garment over the photo locally instead of calling
# Gemini. For building the UI and running `npm run check` without spending quota.
# TRYON_MOCK=1

# Optional. Try-on requests per minute per visitor IP (default 12).
# TRYON_RATE_LIMIT_PER_MIN=12

# Optional. Where generated photos are cached on disk (default: OS temp dir).
# TRYON_CACHE_DIR=
